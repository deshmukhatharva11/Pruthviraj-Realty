# ============================================================
# Pruthviraj Realty — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ============================================================

# NextAuth — REQUIRED
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
# NEXTAUTH_URL should be https://pruthvirajrealty.in for production (Cloudflare Tunnel)
# or http://localhost:3002 for local development
NEXTAUTH_URL=https://pruthvirajrealty.in
PORT=3002

# Admin Credentials — REQUIRED
# This is the ONLY admin account. Use a strong password.
ADMIN_EMAIL=admin@pruthvirajrealty.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Analytics — Optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp — Optional (used for notification webhooks, not chat links)
WHATSAPP_PHONE_NUMBER=919999999999

# Email Notifications — Optional (nodemailer SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL=leads@pruthvirajrealty.com
